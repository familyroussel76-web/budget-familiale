<!doctype html>
<html lang="fr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#123e3b"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Budget familial">
<title>Budget Familial V2.0.0</title><link rel="manifest" href="manifest.webmanifest"><link rel="apple-touch-icon" href="assets/icon-192.png"><link rel="stylesheet" href="style.css">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><script defer src="config.js"></script><script defer src="app.js"></script>
</head><body>
<div id="loadingScreen" class="loading-screen"><div class="loader"></div><strong>Budget Familial</strong><span>Connexion sécurisée…</span></div>
<main id="loginView" class="login-view hidden"><section class="login-card"><div class="brand-mark">€</div><p class="eyebrow">Budget Familial</p><h1>Votre budget partagé</h1><p class="muted">Connectez Laura et Guillaume avec le même compte familial pour retrouver les mêmes dépenses sur tous les appareils.</p><label for="loginEmail">Adresse e-mail</label><input id="loginEmail" type="email" autocomplete="username" placeholder="adresse@email.fr"><label for="loginPassword">Mot de passe</label><input id="loginPassword" type="password" autocomplete="current-password" placeholder="••••••••"><button id="loginBtn" class="btn primary full">Se connecter</button><p id="loginMessage" class="form-message" aria-live="polite"></p><span class="version-chip">Version 2.0.0</span></section></main>
<div id="appView" class="app hidden"><header class="hero"><div class="hero-top"><div><p class="eyebrow light">Budget familial partagé</p><h1 id="headerMonth">Septembre 2026</h1></div><button id="syncBtn" class="icon-btn" aria-label="Actualiser">↻</button></div><select id="monthSelect" class="month-select"></select><div class="hero-stats"><article><span>Revenu</span><strong id="incomeValue">3 200 €</strong></article><article><span>Dépensé</span><strong id="spentValue">0 €</strong></article><article><span>Disponible</span><strong id="availableValue">3 200 €</strong></article></div><div id="syncStatus" class="sync-status">Synchronisé</div></header>
<div class="content"><section id="dashboardScreen" class="screen active"><div class="section-heading"><div><h2>Mes enveloppes</h2><p>Touchez une enveloppe pour modifier son budget.</p></div><button id="incomeBtn" class="btn soft compact">Revenu</button></div><div id="envelopeGrid" class="envelope-grid"></div></section>
<section id="expenseScreen" class="screen"><article class="preview-card"><div><span>Enveloppe sélectionnée</span><h2 id="previewCategory">Alimentation</h2></div><div class="preview-right"><span>Reste après dépense</span><strong id="previewRemaining">900 €</strong></div><div class="progress full-row"><div id="previewProgress" class="progress-bar"></div></div><div class="preview-meta full-row"><span id="previewUsed"></span><span id="previewBudget"></span></div></article><article class="panel"><h2>Ajouter une dépense</h2><div class="form-grid"><div><label for="expenseDate">Date</label><div class="date-wrap"><input id="expenseDate" type="date"></div></div><div><label for="expenseAmount">Montant</label><input id="expenseAmount" type="number" inputmode="decimal" min="0" step="0.01" placeholder="0,00 €"></div></div><label for="expenseCategory">Enveloppe</label><select id="expenseCategory"></select><label for="expensePerson">Personne ou projet</label><select id="expensePerson"></select><label for="expenseLabel">Libellé</label><input id="expenseLabel" type="text" placeholder="Courses, essence, tournoi…"><label for="expenseAuthor">Ajouté par</label><select id="expenseAuthor"><option>Laura</option><option>Guillaume</option><option>Manon</option><option>Sacha</option><option>Gabin</option></select><div class="quick-grid"><button data-quick="10">+10 €</button><button data-quick="20">+20 €</button><button data-quick="50">+50 €</button><button data-quick="100">+100 €</button></div><button id="saveExpenseBtn" class="btn primary full">Enregistrer la dépense</button><p id="expenseMessage" class="form-message"></p></article></section>
<section id="historyScreen" class="screen"><div class="section-heading"><div><h2>Dépenses</h2><p id="expenseCount">0 dépense</p></div></div><input id="expenseSearch" class="search-input" type="search" placeholder="Rechercher une dépense"><div id="expenseList" class="expense-list"></div></section>
<section id="settingsScreen" class="screen"><article class="panel"><h2>Compte familial</h2><p id="accountEmail" class="muted"></p><button id="logoutBtn" class="btn danger full">Se déconnecter</button></article><article class="panel"><h2>Synchronisation</h2><p class="muted">Les dépenses, budgets et revenus sont stockés dans Supabase et partagés entre les appareils connectés au compte familial.</p><button id="refreshBtn" class="btn soft full">Forcer l’actualisation</button></article><article class="panel"><h2>Export Excel</h2><p class="muted">L’export CSV peut être ouvert dans Excel ou Numbers.</p><button id="exportBtn" class="btn soft full">Exporter les dépenses</button></article><article class="panel version-panel"><strong>Budget Familial V2.0.0</strong><span>GitHub Pages + Supabase</span></article></section></div>
<nav class="bottom-nav"><button class="nav-btn active" data-screen="dashboardScreen"><span>⌂</span>Accueil</button><button class="nav-btn" data-screen="expenseScreen"><span>＋</span>Ajouter</button><button class="nav-btn" data-screen="historyScreen"><span>≡</span>Dépenses</button><button class="nav-btn" data-screen="settingsScreen"><span>⚙</span>Réglages</button></nav></div>
<div id="modalBackdrop" class="modal-backdrop hidden"><section id="budgetModal" class="modal hidden"><h2>Modifier l’enveloppe</h2><p id="budgetModalMonth" class="muted"></p><label for="budgetModalName">Enveloppe</label><input id="budgetModalName" readonly><label for="budgetModalAmount">Budget mensuel</label><input id="budgetModalAmount" type="number" inputmode="decimal" min="0" step="1"><div class="modal-actions"><button class="btn soft" data-close-modal>Annuler</button><button id="saveBudgetBtn" class="btn primary">Enregistrer</button></div></section><section id="incomeModal" class="modal hidden"><h2>Revenu disponible</h2><p id="incomeModalMonth" class="muted"></p><label for="incomeModalAmount">Montant du mois</label><input id="incomeModalAmount" type="number" inputmode="decimal" min="0" step="1"><div class="modal-actions"><button class="btn soft" data-close-modal>Annuler</button><button id="saveIncomeBtn" class="btn primary">Enregistrer</button></div></section></div><div id="toast" class="toast hidden"></div>
</body></html>